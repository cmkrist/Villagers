+        for(int slot=0;slot<inventory.getContainerSize();slot++){
+            var item=inventory.getItem(slot);
+            if(item.getCount()!=1||!(item.is(Items.CARROT)||item.is(Items.POTATO))||!fits(item,food,health,maxHealth))continue;
+            int value=item.get(DataComponents.FOOD).nutrition();
+            if(value>nutrition){best=slot;nutrition=value;}
+        }
+        return best;
+    }
