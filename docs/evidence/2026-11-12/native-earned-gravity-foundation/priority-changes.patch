@@ -0,0 +1,24 @@
+package local.villagers;
+
+import net.minecraft.core.BlockPos;
+import org.junit.jupiter.api.Test;
+import static org.junit.jupiter.api.Assertions.*;
+
+class MineGravityFoundationTest {
+    @Test void aFourCellWetFloorCannotOpenWithOnlyThreeActualFillBlocks(){
+        assertFalse(MineGravityFoundation.funded(4,3));
+        assertTrue(MineGravityFoundation.funded(4,4));
+        assertFalse(MineGravityFoundation.funded(5,64));
+        assertFalse(MineGravityFoundation.funded(0,4));
+        assertFalse(MineGravityFoundation.funded(-1,4));
+        assertFalse(MineGravityFoundation.funded(1,-1));
+    }
+    @Test void thePaidColumnTerminatesAtTheProspectiveFloorWithoutOccupyingTheWalkingCell(){
+        var floor=new BlockPos(-475,54,-380);var column=MineGravityFoundation.column(floor,4);
+        assertEquals(java.util.List.of(floor,floor.below(),floor.below(2),floor.below(3)),column);
+        assertFalse(column.contains(floor.above()));
+        assertEquals(new BlockPos(-475,51,-380),column.getLast());
+        assertThrows(IllegalArgumentException.class,()->MineGravityFoundation.column(floor,0));
+        assertThrows(IllegalArgumentException.class,()->MineGravityFoundation.column(floor,5));
+    }
+}
