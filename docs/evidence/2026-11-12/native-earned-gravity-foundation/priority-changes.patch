+            var b=level.getBlockState(p);
+            if(!(b.isAir()||b.is(Blocks.WATER)))return List.of();
+            var support=level.getBlockState(below);
+            if(support.isFaceSturdy(level,below,Direction.UP)&&support.getFluidState().isEmpty())return column(floor,depth);
+        }
+        return List.of();
+    }
+    private static boolean allowed(ServerLevel level,Villager v,Session s){
