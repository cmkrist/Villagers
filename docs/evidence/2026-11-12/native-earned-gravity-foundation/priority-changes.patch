+            ||!VillageSurvival.withinHomeRange(level,s.mind,Vec3.atCenterOf(p))||retained(v,p))return null;
+        for(var p:cells){
+            if(!level.isLoaded(p)||!level.isLoaded(p.above())||ConstructionSites.isProtected(level,p)||MineStair.exitFloor(v,p)
+                ||AdventureQuarry.accessSupport(v,p)||retained(v,p)||NativeTerrainWork.structuralCover(level,p)!=null
