+package local.villagers;
+
+import java.util.*;
+import local.villagers.capability.CapabilityPermissions.Capability;
+import net.minecraft.core.*;
+import net.minecraft.server.level.ServerLevel;
+import net.minecraft.world.InteractionHand;
+import net.minecraft.world.entity.npc.villager.Villager;
+import net.minecraft.world.entity.item.FallingBlockEntity;
+import net.minecraft.world.item.*;
+import net.minecraft.world.level.ClipContext;
+import net.minecraft.world.level.block.*;
+import net.minecraft.world.level.gameevent.GameEvent;
+import net.minecraft.world.phys.*;
+
+/** A funded falling-block column, excavated and placed from a retained dry floor. */
+final class MineGravityFoundation {
+    private static final String TAG="villagers:mine_gravity_fill:";
+    static final int MAX_DEPTH=4;
+    record Plan(BlockPos origin,Direction direction,BlockPos foot,List<BlockPos> column){}
+    static final class State {
+        Plan plan;BlockPos pending;Block pendingBlock;long until,placedAt;int paid,settled,completed;
+        String activity="no gravity foundation";Map<String,Object> receipt=Map.of();
+        void clear(){plan=null;pending=null;pendingBlock=null;}
+        Map<String,Object> status(){return Map.of("active",plan!=null,"paid",paid,"settled",settled,"completed",completed,
+            "activity",activity,"pending",pending==null?"":pending.toShortString(),"lastReceipt",receipt);}
+    }
+    static boolean retained(Villager v,BlockPos p){return v.entityTags().contains(TAG+p.asLong());}
+    /** A settled paid column stays safe beside a face, but never when removing its support. */
+    static boolean stableNeighbor(ServerLevel level,Villager v,BlockPos excavation,BlockPos neighbor){
+        if(!retained(v,neighbor)||neighbor.below().equals(excavation))return false;
+        var at=neighbor;
+        for(int depth=0;depth<MAX_DEPTH;depth++){
+            var below=at.below();if(below.equals(excavation)||!level.isLoaded(below))return false;
+            var b=level.getBlockState(below);
+            if(!b.getFluidState().isEmpty()||!b.isFaceSturdy(level,below,Direction.UP))return false;
+            if(!(b.getBlock() instanceof FallingBlock))return true;
+            if(!retained(v,below))return false;at=below;
+        }
+        return false;
+    }
+    static Map<String,Object> survey(ServerLevel level,Villager v,Session s){
+        var jobs=new ArrayList<Map<String,Object>>();
+        for(var floor:s.mineStair.floors)for(var direction:Direction.Plane.HORIZONTAL){
+            if(floor.above().distSqr(v.blockPosition())>32*32)continue;
+            var plan=preview(level,v,s,floor.above(),direction);
+            if(plan!=null&&jobs.size()<16)jobs.add(Map.of("origin",plan.origin().toShortString(),"direction",direction.name(),
+                "foot",plan.foot().toShortString(),"cost",plan.column().size(),"settlement",plan.column().getLast().toShortString()));
+        }
+        return Map.of("ownedFill",MineFill.count(v.getInventory()),"fundedJobs",jobs);
+    }
+    static boolean funded(int depth,int owned){return depth>=1&&depth<=MAX_DEPTH&&owned>=depth;}
